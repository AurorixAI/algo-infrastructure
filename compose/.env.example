# Copy this schema outside git on the target host as .env.staging or .env.preview.
# Values below are placeholders only. Never commit a populated env file.

# Required secrets — generate independent, high-entropy values.
POSTGRES_PASSWORD=replace-with-a-strong-database-password
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
INTERNAL_SERVICE_TOKEN=replace-with-a-random-service-token-at-least-32-characters

# Each stack must name only the HTTPS frontend that actually calls its APIs.
# Production: ["https://algolab.me"]
# Preview:    ["https://stage.algolab.me"]
CORS_ORIGINS=["https://example.invalid"]

# Values baked into the corresponding frontend build. Use the domain of this stack.
NEXT_PUBLIC_AUTH_API_URL=https://example.invalid/api/v1
NEXT_PUBLIC_EXAM_API_URL=https://example.invalid/api/v1
NEXT_PUBLIC_DIAG_API_URL=https://example.invalid/api/v1

# Primary AI provider. Keep the full Azure chat-completions endpoint, including
# deployment and api-version query parameters, in AZURE_DEEPSEEK_ENDPOINT.
AZURE_DEEPSEEK_API_KEY=
AZURE_DEEPSEEK_ENDPOINT=
AZURE_DEEPSEEK_MODEL=deepseek-v4-flash

# Optional Gemini fallback. It must be configured and tested before relying on
# it during an Azure incident.
GEMINI_API_KEY=

# K3 (A9): public addresses of the auth-service (required; no literals in compose)
CONSOLE_URL=https://console.example.com
SITE_URL=https://example.com
FRONTEND_URL=https://app.example.com
DIAGNOSTIC_BASE_URL=https://app.example.com/d
# true once FRONTEND_URL and SITE_URL are on different hosts (K3 step 7)
REQUIRE_DISTINCT_SITE_HOSTS=false
# Cloudflare Turnstile of the demo form (secret from Cloudflare; hostnames comma-separated)
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=example.com
