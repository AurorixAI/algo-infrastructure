# Nginx — algolab.me as the LANDING (K3 I4–I6). *** DISABLED: NOT LOADED BY NGINX UNTIL RENAMED (step 7) ***
#
# nginx loads only `conf.d/*.conf` (the stock nginx.conf of the image: `include /etc/nginx/conf.d/*.conf;`), so a file
# ending in `.disabled` is ignored. Prepared in advance, checked by `nginx -t` in CI (job «nginx», step 7 rehearsal).
#
# WHAT IT IS: the future blocks `algolab.me` (default_server) and `www.algolab.me` for step 7 of K3_SPEC_v2 §5:
#   * static landing from ~/algo/landing/prod (mounted read-only at /usr/share/nginx/landing-prod); headers, CSP,
#     cache and the 403 for AI crawlers exactly as in algo-landing/SECURITY.md (twin of landing.stage in preview.conf);
#   * `/api/v1/public/` -> auth (the demo form), X-Real-IP / 64k / limit_req as in the product block;
#   * TRANSITIONAL ALIAS of all product APIs for 30 days (open tabs, running exams and diagnostics with the old
#     bundle keep working), each hit counted in a separate log;
#   * everything that is not a landing path -> 302 https://app.algolab.me$request_uri (307 for a non-GET method);
#   * www.algolab.me -> 302 https://algolab.me$request_uri.
#
# ── HOW TO ENABLE (step 7) — ONE change, because two server blocks `algolab.me` + `default_server` cannot coexist ──
#   In the infrastructure repo, ONE commit that does all of:
#     1. git mv nginx/conf.d/staging-apex-landing.conf.disabled nginx/conf.d/staging-apex-landing.conf
#     2. in nginx/conf.d/staging.conf delete the OLD apex product block: everything from the line `# ── HTTPS ───…`
#        up to (not including) the line `# ── app.algolab.me …`:
#          awk '/^# ── HTTPS ─/{s=1} /^# ── app.algolab.me/{s=0} !s' staging.conf > x && mv x staging.conf
#        and delete the line `upstream landing { server algo-staging-landing:5000; }`  (I6; the block with
#        `/landing/` goes away together with the old apex block).
#     3. in compose/docker-compose.staging.yml delete the service `landing` (container algo-staging-landing).
#     4. FRONTEND_URL / DIAGNOSTIC_BASE_URL / FRONTEND_SITE_URL in the server .env (A10) — the same window.
#   Then on the server, in this order (never remove the container before the reload):
#     a. back up conf.d (cp -a ~/algo/algo-infrastructure/nginx/conf.d ~/algo/backup/conf.d.pre-step7);
#     b. nginx -t in a SEPARATE container with the same mounts, and only then `docker exec algo-staging-nginx nginx -s reload`;
#     c. smoke: https://algolab.me/ 200 with CSP; /login 302 -> app.algolab.me/login; app.algolab.me/api/version = sha;
#     d. `docker compose rm -sf landing` (remove algo-staging-landing) and recreate nginx once for the new mounts.
# ── HOW TO ROLL BACK ───────────────────────────────────────────────────────────────────────────────────────────────
#   Restore the backup conf.d (apex is the product again; `.disabled` file back in place) -> nginx -t -> reload.
#   app.algolab.me, the certificate, auth and the mails with app. addresses stay (K3 §5). The container
#   algo-staging-landing was removed: put the service back only if the old landing is really needed (it is not: the
#   old landing is replaced by the static build).
#
# ── AFTER STEP 7 ────────────────────────────────────────────────────────────────────────────────────────────────────
#   day 7  : 302 -> 301 here (the redirects `return 302` below; 307 -> 308) and in the www block;
#   day 30 : remove the section «TRANSITIONAL ALIAS» (and the log) if `api-alias.log` has no hits for a week:
#              awk '{print substr($1,1,10)}' ~/algo/nginx-alias-log/api-alias.log | sort | uniq -c
#            (fields: ISO time, method, path with one-time codes redacted, status, bytes, seconds, user agent; the
#            query string and the Referer are deliberately not logged).
#   CORS: nothing in this file sets CORS headers. `https://algolab.me` must NEVER be added to CORS_ORIGINS (K3 §0 п.5).
#   Payment callbacks and any webhook: only on app.algolab.me, never here (K3 I11).
#
# Depends on the map `$prod_safe_uri`, the `auth` upstream and the `auth` limit_req zone from staging.conf (all three are
# resolved after every file is read, so the load order does not matter for them). Maps use the
# prefix `landing_prod_` (the stage twin in preview.conf uses `landing_stage_`): keep the two blocks in sync.

map $uri $landing_prod_cache {
    default                          "no-cache";
    ~^/assets/                       "public, max-age=31536000, immutable";
    ~^/(robots\.txt|sitemap\.xml)$   "public, max-age=3600, must-revalidate";
}

# 403 for declared AI crawlers (SECURITY.md). robots.txt stays readable for them: a crawler that gets 403 there
# treats the site as «no restrictions».
map $http_user_agent $landing_prod_bot_ua {
    default 0;
    ~*\b(GPTBot|OAI-SearchBot|ChatGPT-User|ClaudeBot|Claude-User|Claude-SearchBot|CCBot|PerplexityBot|Perplexity-User|Bytespider)\b 1;
}
map $uri $landing_prod_robots_path {
    default      0;
    /robots.txt  1;
}
map "$landing_prod_bot_ua$landing_prod_robots_path" $landing_prod_bot {
    default 0;
    "10"    1;
}

# Hits of the transitional alias (and of API-like paths that only get redirected): a separate log for the 30-day counter.
map $uri $landing_prod_api_alias {
    default                0;
    ~^/api/v1/(public|platform)/ 0;
    ~^/api/                1;
}
# The same line as `prod_safe` in staging.conf (one-time codes and tokens are redacted by `$prod_safe_uri`). Its own name on
# purpose: conf.d files are loaded in alphabetical order and `staging-apex-landing.conf` sorts BEFORE `staging.conf`
# ('-' < '.'), and a log_format must be defined before the access_log that names it.
log_format landing_prod_safe '$remote_addr - [$time_local] "$request_method $prod_safe_uri $server_protocol" $status $body_bytes_sent $request_time "$http_user_agent"';
log_format api_alias '$time_iso8601 $request_method $prod_safe_uri $status $body_bytes_sent $request_time "$http_user_agent"';

# www -> apex (one address for search engines, K3 risk B10). 302 first week, then 301.
server {
    listen 443 ssl;
    http2 on;
    server_name www.algolab.me;
    access_log /var/log/nginx/access.log landing_prod_safe;

    ssl_certificate     /etc/letsencrypt/live/algolab.me/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/algolab.me/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    location / {
        if ($request_method !~ ^(GET|HEAD)$) {
            return 307 https://algolab.me$request_uri;
        }
        return 302 https://algolab.me$request_uri;
    }
}

# `default_server` is explicit on purpose (see the old apex block in staging.conf): a request whose Host matches nothing
# gets the landing, not the product (K3 B20).
server {
    listen 443 ssl default_server;
    http2 on;
    server_name algolab.me;
    access_log /var/log/nginx/access.log landing_prod_safe;
    access_log /var/log/nginx-alias/api-alias.log api_alias if=$landing_prod_api_alias;

    ssl_certificate     /etc/letsencrypt/live/algolab.me/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/algolab.me/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    client_max_body_size 50m;                  # the alias carries imports; the landing's own API is limited to 64k below
    proxy_max_temp_file_size 0;

    gzip            on;
    gzip_vary       on;
    gzip_min_length 1024;
    gzip_types      text/css application/javascript application/json image/svg+xml application/xml text/plain;

    proxy_hide_header Content-Security-Policy;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header Referrer-Policy;
    proxy_hide_header Permissions-Policy;
    proxy_hide_header Cross-Origin-Opener-Policy;
    proxy_hide_header Cross-Origin-Resource-Policy;
    proxy_hide_header Strict-Transport-Security;
    proxy_hide_header Cache-Control;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-4aGtvtcALQgeHnlSqbuF2OnJMzibRdE21wZJyYZkEuY=' https://challenges.cloudflare.com; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; object-src 'none'; base-uri 'none'; form-action 'self'; manifest-src 'self'; media-src 'self'; worker-src 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Resource-Policy "same-origin" always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Cache-Control $landing_prod_cache;

    if ($landing_prod_bot) {
        return 403;
    }

    root  /usr/share/nginx/landing-prod;
    index index.html;

    location ^~ /. {
        return 404;
    }

    # ── API of the landing: the demo form (permanent) ──────────────────────────────────────────────────────────────
    # The console API is served only on console.algolab.me (K1).
    location /api/v1/platform/ {
        return 404;
    }

    # Public «Запросить демо» form (K1).
    location /api/v1/public/ {
        client_max_body_size 64k;          # K3: the demo form is a small JSON; the server block allows 50m for imports
        proxy_pass         http://auth/api/v1/public/;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
        limit_req          zone=auth burst=20 nodelay;
    }


    # ── The paths the landing owns (the build of algo-landing/client: index.html + client/public) ─────────────────
    location = / {
        try_files /index.html =404;
    }
    location = /index.html {
        try_files /index.html =404;
    }
    location ~ ^/(favicon\.svg|favicon\.png|opengraph\.jpg|opengraph\.png|opengraph-source\.svg|robots\.txt|sitemap\.xml)$ {
        try_files $uri =404;
    }
    location ~ ^/(assets|fonts|samples)/ {
        try_files $uri =404;
    }

    # ── TRANSITIONAL ALIAS of the product API (30 days from step 7; remove at day 30, see the header) ─────────────────
    # The same locations as in the app.algolab.me block (verbatim). Open tabs with the old bundle (it knows the absolute
    # https://algolab.me/api/v1), exams and diagnostics in progress, and the Telegram app (if it still calls this host)
    # keep working. Hits are counted in /var/log/nginx-alias/api-alias.log (see the `access_log … if=` above).
    location /api/v1/auth/ {
        proxy_pass         http://auth/api/v1/auth/;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
        limit_req          zone=auth burst=20 nodelay;
    }

    location /api/v1/organizations/ {
        proxy_pass         http://auth/api/v1/organizations/;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    # Exam history is owned by exam-service; the remaining student routes
    # continue to use auth. Regex wins over the general student prefix.
    location ~ ^/api/v1/students/[^/]+/exam-history$ {
        proxy_pass         http://exam;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location /api/v1/students/ {
        proxy_pass         http://auth/api/v1/students/;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    location /api/v1/groups/ {
        proxy_pass         http://auth/api/v1/groups/;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    location /api/v1/diagnostic/ {
        proxy_pass         http://diagnostic/api/v1/diagnostic/;
        # DIAG-6: answers are capped at 2000 chars; no diagnostic request needs more than a few KB
        client_max_body_size 256k;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # Analytics lives in diagnostics-service too (separate router/prefix) —
    # without this block every analyticsApi.* call 404s by falling through
    # to the frontend catch-all instead of reaching the backend.
    location /api/v1/analytics/ {
        proxy_pass         http://diagnostic/api/v1/analytics/;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location /api/v1/exam {
        proxy_pass         http://exam/api/v1/exam;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # exam-service also owns the textbook catalogue the exam builder reads
    # (list, skill tree, table of contents, tasks). Without these blocks the
    # requests fell through to the frontend catch-all and answered 404, so
    # "По учебнику" and "По темам" could never load. `/api/v1/internal` and
    # `/api/v1/toc` are deliberately NOT exposed: the first is
    # service-to-service only, the second is not called by any client.
    location /api/v1/textbooks {
        proxy_pass         http://exam/api/v1/textbooks;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # Organisation-wide, read-only exam monitoring for admins.
    location /api/v1/admin/ {
        proxy_pass         http://exam/api/v1/admin/;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }


    # Deliberately no public /api/v1/content/ route.  The content read API
    # includes correct answers and distractor metadata for exam/diagnostic
    # services, so it is reachable only through the internal Docker network.
    # Student-facing figures are served by the frontend's constrained proxy.

    # The old landing was served under /landing/ (K3 B11, I6): its address now leads to the one page of the landing.
    location ^~ /landing/ {
        return 302 /;
    }

    # ── Everything else is a product path → app.algolab.me ─────────────────────────────────────────────────────────
    # Old links: /login, /owner/…, /admin/…, /teacher/…, /d/<code>, /diagnostic/<code>, /e/<code>, /invite/<code>,
    # /activate?token=…, /set-password/<token>, /change-password, /register, /request-demo (the product sends the last two
    # on to the landing), /api/version, /favicon.ico … Path and query are kept. 302 for the first week, then 301/308.
    location / {
        if ($request_method !~ ^(GET|HEAD)$) {
            return 307 https://app.algolab.me$request_uri;
        }
        return 302 https://app.algolab.me$request_uri;
    }
}
