# Copy this schema outside git on the target host as .env.staging or .env.preview.
# Values below are placeholders only. Never commit a populated env file.

# Required secrets — generate independent, high-entropy values.
POSTGRES_PASSWORD=replace-with-a-strong-database-password
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
INTERNAL_SERVICE_TOKEN=replace-with-a-random-service-token-at-least-32-characters

# Each stack must name only the HTTPS frontend that actually calls its APIs.
# Production: the product lives on app.algolab.me (K3); algolab.me is the landing and is NEVER added here (K3 §0 п.5:
#             otherwise the landing's scripts could read the API of a signed-in user). Until K3 step 7 the old value stays.
# Preview:    ["https://stage.algolab.me"] (the product on stage; landing.stage.algolab.me is not listed either)
CORS_ORIGINS=["https://example.invalid"]

# Built into the frontend. K3 P1: keep ALL THREE EMPTY on prod and stage: empty = the origin the page was opened from, so one
# image serves any domain (app.algolab.me, stage.algolab.me). Never write an https://… address here.
NEXT_PUBLIC_AUTH_API_URL=
NEXT_PUBLIC_EXAM_API_URL=
NEXT_PUBLIC_DIAG_API_URL=

# K3 P2 (RUNTIME variables of the frontend container, not NEXT_PUBLIC_*; no NEXT_PUBLIC_SITE_URL exists):
#   FRONTEND_SITE_URL  public landing address, target of «Нет доступа? Запросить демо» and of the old /request-demo, /register links.
#                      prod: https://algolab.me (today and after step 7); preview: https://landing.stage.algolab.me
#   SUPPORT_EMAIL      optional; shown on /demo-contact when the landing address is empty or equals the host itself
FRONTEND_SITE_URL=https://example.com
SUPPORT_EMAIL=

# Primary AI provider. Keep the full Azure chat-completions endpoint, including
# deployment and api-version query parameters, in AZURE_DEEPSEEK_ENDPOINT.
AZURE_DEEPSEEK_API_KEY=
AZURE_DEEPSEEK_ENDPOINT=
AZURE_DEEPSEEK_MODEL=deepseek-v4-flash

# Optional Gemini fallback. It must be configured and tested before relying on
# it during an Azure incident.
GEMINI_API_KEY=

# K3 (A9): public addresses of the auth-service (required; no literals in compose)
CONSOLE_URL=https://console.example.com
SITE_URL=https://example.com
FRONTEND_URL=https://app.example.com
DIAGNOSTIC_BASE_URL=https://app.example.com/d
# true once FRONTEND_URL and SITE_URL are on different hosts (K3 step 7)
REQUIRE_DISTINCT_SITE_HOSTS=false
# Cloudflare Turnstile of the demo form (secret from Cloudflare; hostnames comma-separated)
TURNSTILE_SECRET_KEY=
# K2-2 (B): «Забыли пароль» on app. / stage. checks Turnstile too: the list must hold EVERY host that shows a widget (LESSONS 68)
TURNSTILE_HOSTNAMES=example.com
# K2-2 (B): the PUBLIC site key of the same widget, baked into the front at build time (empty = no widget; then the server must hold no secret)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# K2-1: letters and the length of a session (all have defaults in compose; set them in the server env files only to change them)
#   MAIL_REPLY_TO           Reply-To of every letter: the SUPPORT ALIAS (an alias of the Zoho mailbox), never a personal address. Same on prod and stage.
#   MAIL_ALLOWLIST          addresses / domains (comma separated) that may get a letter. EMPTY on prod = no restriction.
#                           On the STAGE it is the whole guard: only these get a letter, and nobody while it is empty.
#   MAIL_STAGE_MODE         set to true in docker-compose.preview.yml (both stacks run APP_ENV=staging, so the stage says so itself); do not set it on prod.
#   JWT_REFRESH_TTL_DAYS    a session signed in with «Запомнить меня» lasts this long from the last visit (14); without the tick it lasts 12 h from the sign-in.
MAIL_REPLY_TO=support@algolab.me
MAIL_ALLOWLIST=
JWT_REFRESH_TTL_DAYS=14
